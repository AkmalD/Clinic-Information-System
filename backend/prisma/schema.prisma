// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================

enum Role {
  ADMIN
  DOKTER
  PETUGAS
  FARMASI
}

enum JenisKelamin {
  L
  P
}

enum JenisPembayaran {
  UMUM
  BPJS
  ASURANSI
}

enum StatusKunjungan {
  MENUNGGU
  CHECK_IN
  PEMERIKSAAN
  PEMBAYARAN
  FARMASI
  SELESAI
}

enum StatusAntrean {
  MENUNGGU
  DIPANGGIL
  SELESAI
}

enum StatusPembayaran {
  MENUNGGU_PEMBAYARAN
  LUNAS
  DITANGGUNG_BPJS
  DITANGGUNG_ASURANSI
  BATAL
}

enum MetodePembayaran {
  TUNAI
  QRIS
  TRANSFER
  GATEWAY
  BPJS
  ASURANSI
}

enum StatusResep {
  MENUNGGU
  DISERAHKAN
  BATAL
}

// ==========================
// MASTER DATA
// ==========================

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  role        Role
  namaLengkap String   @map("nama_lengkap")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  doctor                 Doctor?
  registrations          Registration[]
  dispensedPrescriptions Prescription[]

  @@map("users")
}

model Poli {
  id       Int    @id @default(autoincrement())
  kodePoli String @unique @map("kode_poli")
  namaPoli String @map("nama_poli")

  doctors       Doctor[]
  registrations Registration[]
  queues        Queue[]

  @@map("poli")
}

model Doctor {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique @map("user_id")
  nama            String
  poliId          Int     @map("poli_id")
  noSip           String? @map("no_sip")
  biayaKonsultasi Int     @default(50000) @map("biaya_konsultasi")

  user           User            @relation(fields: [userId], references: [id])
  poli           Poli            @relation(fields: [poliId], references: [id])
  registrations  Registration[]
  medicalRecords MedicalRecord[]

  @@map("doctors")
}

model Medicine {
  id       Int    @id @default(autoincrement())
  namaObat String @map("nama_obat")
  satuan   String
  harga    Int    @default(0)

  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

model Patient {
  id           Int          @id @default(autoincrement())
  noRm         String       @unique @map("no_rm")
  nik          String       @unique
  nama         String
  jenisKelamin JenisKelamin @map("jenis_kelamin")
  tanggalLahir DateTime     @map("tanggal_lahir") @db.Date
  noTelp       String       @map("no_telp")
  alamat       String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  registrations  Registration[]
  medicalRecords MedicalRecord[]

  @@index([nama])
  @@map("patients")
}

// ==========================
// TRANSAKSI KLINIK
// ==========================

model Registration {
  id               Int             @id @default(autoincrement())
  noRegistrasi     String          @unique @map("no_registrasi")
  patientId        Int             @map("patient_id")
  doctorId         Int             @map("doctor_id")
  poliId           Int             @map("poli_id")
  tanggalKunjungan DateTime        @map("tanggal_kunjungan") @db.Date
  jenisPembayaran  JenisPembayaran @map("jenis_pembayaran")
  keluhanAwal      String?         @map("keluhan_awal")
  status           StatusKunjungan @default(MENUNGGU)
  createdById      Int             @map("created_by")
  createdAt        DateTime        @default(now()) @map("created_at")

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  poli          Poli           @relation(fields: [poliId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  queue         Queue?
  medicalRecord MedicalRecord?
  invoice       Invoice?

  @@index([tanggalKunjungan])
  @@map("registrations")
}

model Queue {
  id             Int           @id @default(autoincrement())
  registrationId Int           @unique @map("registration_id")
  nomorAntrean   String        @map("nomor_antrean")
  poliId         Int           @map("poli_id")
  tanggal        DateTime      @db.Date
  status         StatusAntrean @default(MENUNGGU)
  calledAt       DateTime?     @map("called_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id])
  poli         Poli         @relation(fields: [poliId], references: [id])

  @@unique([tanggal, poliId, nomorAntrean])
  @@index([tanggal, poliId])
  @@map("queues")
}

model MedicalRecord {
  id             Int      @id @default(autoincrement())
  registrationId Int      @unique @map("registration_id")
  patientId      Int      @map("patient_id")
  doctorId       Int      @map("doctor_id")
  keluhan        String   // Subjective
  tekananDarah   String   @map("tekanan_darah")   // Objective
  suhuTubuh      Float    @map("suhu_tubuh")      // Objective
  beratBadan     Float    @map("berat_badan")     // Objective
  tinggiBadan    Float    @map("tinggi_badan")    // Objective
  diagnosa       String                           // Assessment
  rencanaTerapi  String   @map("rencana_terapi")  // Plan
  createdAt      DateTime @default(now()) @map("created_at")

  registration   Registration    @relation(fields: [registrationId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  doctor         Doctor          @relation(fields: [doctorId], references: [id])
  medicalActions MedicalAction[]
  prescriptions  Prescription[]

  @@map("medical_records")
}

model MedicalAction {
  id              Int     @id @default(autoincrement())
  medicalRecordId Int     @map("medical_record_id")
  namaTindakan    String  @map("nama_tindakan")
  keterangan      String?

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id])

  @@map("medical_actions")
}

model Prescription {
  id              Int         @id @default(autoincrement())
  medicalRecordId Int         @map("medical_record_id")
  status          StatusResep @default(MENUNGGU)
  dispensedAt     DateTime?   @map("dispensed_at")
  dispensedById   Int?        @map("dispensed_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  medicalRecord MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  dispensedBy   User?              @relation(fields: [dispensedById], references: [id])
  items         PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int    @id @default(autoincrement())
  prescriptionId Int    @map("prescription_id")
  medicineId     Int    @map("medicine_id")
  dosis          String
  jumlah         Int
  aturanPakai    String @map("aturan_pakai")

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("prescription_items")
}

model Invoice {
  id               Int              @id @default(autoincrement())
  registrationId   Int              @unique @map("registration_id")
  noInvoice        String           @unique @map("no_invoice")
  totalBiaya       Int              @map("total_biaya")
  biayaKonsultasi  Int              @map("biaya_konsultasi")
  biayaTindakan    Int              @default(0) @map("biaya_tindakan")
  biayaObat        Int              @default(0) @map("biaya_obat")
  totalPasienBayar Int              @map("total_pasien_bayar")
  jenisPembayaran  JenisPembayaran  @map("jenis_pembayaran")
  status           StatusPembayaran @default(MENUNGGU_PEMBAYARAN)
  metode           MetodePembayaran?
  paymentToken     String?          @map("payment_token")
  nomorPenjamin    String?          @map("nomor_penjamin")
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id])

  @@map("invoices")
}